<Window x:Class="ScriptPlayer.Dialogs.DeviceManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:ScriptPlayer.Shared;assembly=ScriptPlayer.Shared"
        xmlns:converters="clr-namespace:ScriptPlayer.Converters"
        xmlns:interfaces="clr-namespace:ScriptPlayer.Shared.Interfaces;assembly=ScriptPlayer.Shared"
        mc:Ignorable="d" DataContext="{Binding RelativeSource={RelativeSource Self}}" SizeToContent="Height"
        Title="Device Manager" Height="300" Width="344.492" WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:DeviceToImageConverter x:Key="DeviceConverter"/>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12" HorizontalAlignment="Stretch">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <TextBlock Text="No Devices Connected" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                       Foreground="{DynamicResource MediaMutedBrush}" TextWrapping="Wrap"/>
        </Grid>
        <Grid Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Devices}" HorizontalContentAlignment="Stretch">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Devices.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type interfaces:IDevice}">
                        <Border HorizontalAlignment="Stretch" Background="{DynamicResource MediaRaisedBrush}" BorderBrush="{DynamicResource MediaBorderBrush}"
                                BorderThickness="1" CornerRadius="{DynamicResource MediaCardRadius}" Padding="12,8" Margin="0,0,0,8">
                            <DockPanel LastChildFill="True" HorizontalAlignment="Stretch">
                                <CheckBox Height="40" IsChecked="{Binding IsEnabled}" DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="{Binding Name}" ToolTip="启用或停用此设备"/>
                                <Image Width="32" Height="32" Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" DockPanel.Dock="Left" Source="{Binding Converter={StaticResource DeviceConverter}}"/>
                                <TextBlock Margin="8,0,12,0" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Orientation="Horizontal">
            <TextBlock Foreground="{DynamicResource MediaMutedBrush}" FontSize="{DynamicResource MediaCaptionFontSize}"
                       VerticalAlignment="Center" TextWrapping="Wrap" Text="Device images by "/>
        <Button Content="Funjack" Cursor="Hand" Click="BtnFunjack_Click">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <TextBlock TextDecorations="Underline">
                        <ContentPresenter />
                    </TextBlock>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource MediaButton}">
                    <Setter Property="FontSize" Value="{DynamicResource MediaCaptionFontSize}"/>
                    <Setter Property="Foreground" Value="{DynamicResource MediaMutedBrush}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Foreground" Value="{DynamicResource MediaAccentBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        
        </StackPanel>
    </Grid>
</Window>
