<Window x:Class="ScriptPlayer.Dialogs.SerialPortSelector"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 DataContext="{Binding RelativeSource={RelativeSource Self}}"
 Title="Serial Port Options" Width="440" SizeToContent="Height">
  <StackPanel Margin="0,8">
    <TextBlock Text="Serial Port" Margin="0,0,0,8"/>
    <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort, Mode=TwoWay}" AutomationProperties.Name="TCode COM port" MinWidth="120"/>
    <WrapPanel Margin="0,16,0,0">
      <Button IsDefault="True" Content="连接所选串口" Margin="0,0,8,8" Click="Button_Click"/>
      <Button IsCancel="True" Content="Cancel" Margin="0,0,8,8"/>
    </WrapPanel>
  </StackPanel>
</Window>
