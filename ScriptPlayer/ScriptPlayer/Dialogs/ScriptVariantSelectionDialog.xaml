<Window x:Class="ScriptPlayer.Dialogs.ScriptVariantSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择同步脚本" Height="360" Width="620" MinHeight="280" MinWidth="480"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="检测到多个同名脚本，请选择本次与视频同步的版本：" Margin="0,0,0,10"/>
        <ListBox x:Name="lstVariants" Grid.Row="1" MouseDoubleClick="LstVariants_OnMouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding FullPath}" Foreground="DimGray" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="使用此脚本" IsDefault="True" Width="110" Margin="0,0,8,0" Click="BtnSelect_OnClick"/>
            <Button Content="取消" IsCancel="True" Width="88"/>
        </StackPanel>
    </Grid>
</Window>
