<Window x:Class="ScriptPlayer.Dialogs.EditFavouriteFolderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScriptPlayer.Dialogs"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Favourite Folder" Height="134.818" Width="409.844">
    <Grid Margin="0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="Path" VerticalAlignment="Center" Margin="0,0,12,12"/>
        <TextBox Grid.Column="1" Text="{Binding Path}" TextWrapping="Wrap" Margin="0,0,8,12"/>
        <Button Grid.Column="2" Click="btnSelectPath_Click" Content="..." Margin="0,0,0,12" MinWidth="36"/>
        <TextBlock Grid.Row="1" Text="Name" VerticalAlignment="Center" Margin="0,0,12,12"/>
        <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding FolderName}" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Name="cckDefault" Content="Default" IsChecked="{Binding IsDefault}" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button IsDefault="True" Click="btnOk_Click" Content="Ok" MinWidth="75" Margin="0,0,8,0"/>
            <Button IsCancel="True" Click="btnCancel_Click" Content="Cancel" MinWidth="75"/>
        </StackPanel>
    </Grid>
</Window>
