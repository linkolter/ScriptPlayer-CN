<Window x:Class="ScriptPlayer.Dialogs.SectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScriptPlayer.Dialogs"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner" WindowStyle="ToolWindow"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="Selection Section" Height="210" Width="360" MinWidth="260">
    <Grid Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" TextWrapping="Wrap" Text="From" MaxWidth="100" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBox Grid.Row="0" Grid.Column="2" MinHeight="36" TextWrapping="Wrap" Text="{Binding TimeFrom}" Margin="0,0,0,12"/>
        <TextBlock Grid.Row="1" TextWrapping="Wrap" Text="To" MaxWidth="100" VerticalAlignment="Center" Margin="0,0,0,12"/>
        <TextBox Grid.Row="1" Grid.Column="2" MinHeight="36" TextWrapping="Wrap" Text="{Binding TimeTo}" Margin="0,0,0,12"/>
        <WrapPanel Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,4,0,0">
            <Button Content="Ok" IsDefault="True" MinHeight="36" MinWidth="88" Margin="0,0,8,0" Click="Button_Click"/>
            <Button Content="Cancel" IsCancel="True" MinHeight="36" MinWidth="88"/>
        </WrapPanel>
    </Grid>
</Window>
