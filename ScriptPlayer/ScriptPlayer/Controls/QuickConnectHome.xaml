<UserControl x:Class="ScriptPlayer.Controls.QuickConnectHome"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource MediaFontFamily}" FontSize="{DynamicResource MediaBodyFontSize}" Foreground="{DynamicResource MediaTextBrush}"
             Background="{DynamicResource MediaBackgroundBrush}">
    <UserControl.Resources>
        <Style x:Key="DeviceCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource MediaSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MediaBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Width" Value="278"/>
            <Setter Property="MinHeight" Value="158"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MediaHoverBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource MediaAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource MediaAccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource MediaPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="20,28" VerticalAlignment="Center">
            <StackPanel MaxWidth="720" HorizontalAlignment="Center">
                <Image Source="/ScriptPlayer;component/Images/ScriptPlayerIcon.png" Height="64" Width="64" Margin="0,0,0,16"/>
                <TextBlock Text="ScriptPlayer 汉化版" FontSize="{DynamicResource MediaHeadingFontSize}" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="选择设备，开始连接" FontSize="{DynamicResource MediaBodyFontSize}" Foreground="{DynamicResource MediaMutedBrush}" TextAlignment="Center" Margin="0,10,0,22"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button x:Name="HandyConnectButton" Style="{StaticResource DeviceCard}"
                            Command="{Binding ConnectHandyDirectlyCommand}" AutomationProperties.Name="连接 Handy">
                        <StackPanel>
                            <TextBlock Text="Handy" FontSize="{DynamicResource MediaSectionFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource MediaTextBrush}"/>
                            <TextBlock Text="使用连接密钥连接，首次使用可设置。" TextWrapping="Wrap" FontSize="{DynamicResource MediaCaptionFontSize}" Foreground="{DynamicResource MediaMutedBrush}" Margin="0,10,0,18"/>
                            <TextBlock Text="连接 Handy  →" FontSize="{DynamicResource MediaBodyFontSize}" Foreground="{DynamicResource MediaAccentBrush}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="Osr6ConnectButton" Style="{StaticResource DeviceCard}"
                            Command="{Binding ConnectTCodeWifiCommand}" AutomationProperties.Name="连接 OSR6">
                        <StackPanel>
                            <TextBlock Text="OSR6 / SR6" FontSize="{DynamicResource MediaSectionFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource MediaTextBrush}"/>
                            <TextBlock Text="通过 Wi-Fi 连接，记住上次设备地址。" TextWrapping="Wrap" FontSize="{DynamicResource MediaCaptionFontSize}" Foreground="{DynamicResource MediaMutedBrush}" Margin="0,10,0,18"/>
                            <TextBlock Text="连接 OSR6  →" FontSize="{DynamicResource MediaBodyFontSize}" Foreground="{DynamicResource MediaAccentBrush}"/>
                        </StackPanel>
                    </Button>
                </WrapPanel>
                <Button Content="打开视频" Command="{Binding OpenVideoCommand}" Padding="24,9" Margin="0,20,0,0"
                        HorizontalAlignment="Center" Background="{DynamicResource MediaRaisedBrush}" Foreground="{DynamicResource MediaTextBrush}" BorderBrush="{DynamicResource MediaBorderBrush}"/>
                <TextBlock Text="连接设备后，打开视频或脚本即可开始。" Foreground="{DynamicResource MediaMutedBrush}" FontSize="{DynamicResource MediaCaptionFontSize}"
                           Margin="12,16,12,0" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
