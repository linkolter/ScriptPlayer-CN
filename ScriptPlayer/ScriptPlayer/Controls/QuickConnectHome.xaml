<UserControl x:Class="ScriptPlayer.Controls.QuickConnectHome"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:ScriptPlayer.Controls">
  <UserControl.Resources>
    <local:TCodeStatusDisplayConverter x:Key="DeviceStatusDisplay"/>
    <Style x:Key="DeviceCard" TargetType="Button" BasedOn="{StaticResource MediaButton}">
      <Setter Property="Width" Value="200"/><Setter Property="MinHeight" Value="132"/>
      <Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="16"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
  </UserControl.Resources>
  <StackPanel Margin="0,0,0,20">
    <TextBlock Text="先连接设备" FontSize="{DynamicResource MediaSectionFontSize}" FontWeight="SemiBold"/>
    <TextBlock Text="选择连接方式，在对应子页完成配置。也可以直接播放视频。" Foreground="{DynamicResource MediaMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>
    <WrapPanel>
      <Button x:Name="HandyConnectButton" Style="{StaticResource DeviceCard}" Tag="The Handy" Click="Device_Click" AutomationProperties.Name="配置与连接 Handy">
        <StackPanel><TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource MediaAccentBrush}" Margin="0,0,0,12"/><TextBlock Text="Handy" FontWeight="SemiBold"/><TextBlock Text="连接密钥 · 在线连接" Foreground="{DynamicResource MediaMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
      </Button>
      <Button x:Name="Osr6ConnectButton" Style="{StaticResource DeviceCard}" Tag="TCode Wi-Fi" Click="Device_Click" AutomationProperties.Name="配置 OSR6 / SR6 Wi-Fi">
        <StackPanel><TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource MediaAccentBrush}" Margin="0,0,0,12"/><TextBlock Text="OSR6 / SR6 Wi-Fi" FontWeight="SemiBold"/><TextBlock Text="局域网 · TCode UDP" Foreground="{DynamicResource MediaMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
      </Button>
      <Button x:Name="SerialConnectButton" Style="{StaticResource DeviceCard}" Tag="TCode Serial" Click="Device_Click" AutomationProperties.Name="配置 USB 串口">
        <StackPanel><TextBlock Text="&#xE88E;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource MediaAccentBrush}" Margin="0,0,0,12"/><TextBlock Text="USB 串口" FontWeight="SemiBold"/><TextBlock Text="OSR6 / SR6 · TCode" Foreground="{DynamicResource MediaMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
      </Button>
      <Button x:Name="BluetoothConnectButton" Style="{StaticResource DeviceCard}" Tag="TCode Bluetooth" Click="Device_Click" AutomationProperties.Name="配置蓝牙串口 SPP COM">
        <StackPanel><TextBlock Text="&#xE702;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource MediaAccentBrush}" Margin="0,0,0,12"/><TextBlock Text="蓝牙串口" FontWeight="SemiBold"/><TextBlock Text="已配对 SPP / COM · 非 BLE" Foreground="{DynamicResource MediaMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
      </Button>
    </WrapPanel>
    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MediaMutedBrush}" Margin="0,0,0,8"><TextBlock.Text><MultiBinding Converter="{StaticResource DeviceStatusDisplay}"><Binding Path="TCodeStatus"/><Binding Path="Settings.InterfaceLanguage"/></MultiBinding></TextBlock.Text></TextBlock>
    <WrapPanel><Button Content="已连接设备" Tag="Device Manager" Click="Device_Click" Margin="0,0,8,8"/><Button Content="其他设备 / Buttplug" Tag="Buttplug" Click="Device_Click" Margin="0,0,8,8"/></WrapPanel>
  </StackPanel>
</UserControl>
