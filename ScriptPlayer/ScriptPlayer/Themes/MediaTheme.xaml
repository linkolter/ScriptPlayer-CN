    <Setter Property="Width" Value="36"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="8"/>
    <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="MediaToggleButton" TargetType="ToggleButton">
    <Setter Property="Foreground" Value="{DynamicResource MediaTextBrush}"/><Setter Property="Background" Value="{DynamicResource MediaSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MediaBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="{StaticResource MediaControlPadding}"/><Setter Property="MinHeight" Value="36"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
